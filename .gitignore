# ── Dependencies ──────────────────────────────────────────
node_modules/

# ── Environment variables ─────────────────────────────────
# .env.example is committed as a template — everything else is secret
.env
.env.local
.env.*.local

# ── Database ──────────────────────────────────────────────
# SQLite legacy files (project now uses PostgreSQL via Prisma)
*.db
*.sqlite
*.sqlite3

# Prisma generated client (regenerated via `npx prisma generate`)
node_modules/.prisma/

# ── Build / Production ────────────────────────────────────
dist/
build/
.out/

# ── Vite ──────────────────────────────────────────────────
.vite/

# ── TypeScript ────────────────────────────────────────────
*.tsbuildinfo

# ── Logs ──────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS files ──────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE / Editors ─────────────────────────────────────────
.idea/
*.swp
*.swo
# .vscode/ is kept so shared editor settings are committed

# ── Test / Coverage ───────────────────────────────────────
coverage/

# ── Temporary files ───────────────────────────────────────
tmp/
temp/

# ── Node process files ────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock
